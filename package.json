{
  "name": "the-saver",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "server": "node server/index.mjs",
    "setup:server": "node scripts/setup-server.mjs",
    "build": "expo export --platform android --platform ios --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.4",
    "expo": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-media-library": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  },
  "devDependencies": {}
}
