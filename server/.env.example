# Copy to server/.env. Never put provider secrets in EXPO_PUBLIC_* variables.
# Official is the default. Set legacy explicitly only for public yt-dlp downloads.
MEDIA_ACCESS_MODE=official
# Public HTTPS origin routing to this backend. Must match registered callbacks.
OAUTH_PUBLIC_BASE_URL=https://your-media-server.example
X_CLIENT_ID=
# Optional for a public OAuth client; required for a confidential web client.
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Choose a supported version from your Meta app dashboard (format: vNN.0).
META_GRAPH_VERSION=
